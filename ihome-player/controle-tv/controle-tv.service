[Unit]
Description=Controle do Kodi também na TV Sony (Home + DEL alterna)
After=systemd-udevd.service network-online.target
Wants=network-online.target
Before=plasmalogin.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/controle-tv.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
